{
  "name": "lpm",
  "version": "1.3.0",
  "description": "npm包缓存和发布工具",
  "type": "module",
  "bin": "./main.js",
  "scripts": {
    "start": "bun run ./main.js",
    "build": "bun build --compile --minify --sourcemap --outfile dist/lpm.exe --target node ./main.js"
  },
  "dependencies": {
    "log4js": "^6.9.1",
    "progress": "^2.0.3",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "prettier": "3.1.0"
  }
}

{
  "name": "lpm",
  "version": "1.3.1",
  "description": "npm包缓存和发布工具",
  "type": "module",
  "bin": "./main.js",
  "scripts": {
    "debug": "bun --inspect-brk ./main.js",
    "start": "bun run ./main.js",
    "build": "bun build --compile --minify --sourcemap --outfile dist/lpm.exe --target node ./main.js",
    "format": "bunx prettier --write .",
    "lint": "bunx eslint ."
  },
  "dependencies": {
    "log4js": "^6.9.1",
    "progress": "^2.0.3",
    "readline-sync": "^1.4.10",
    "yaml": "^2.8.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "3.1.0"
  }
}
